# IAM ACCESS KEY
AWS_ACCESS_KEY_ID=YOUR_ACTUAL_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_ACTUAL_SECRET_ACCESS_KEY
AWS_DEFAULT_REGION=ap-northeast-2

# S3 호환 저장소(Cloudflare R2)를 쓸 때만 채운다. 비우면 AWS S3.
# R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com · AWS_DEFAULT_REGION=auto · 키는 R2 API 토큰 값
S3_ENDPOINT_URL=
S3_BUCKET=
