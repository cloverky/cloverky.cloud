[importlinter]
root_packages =
    fridge
    titanic
    secom
    doro
    friday_13th
    imitation_game
    inception
    lion_king
    silicon_valley
    users
    star_craft
    core
    auth
    weather

[importlinter:contract:auth-isolation]
# Harness Rule: apps/auth 는 auth_main 엔트리포인트 전용이다.
# 비즈니스 스포크가 쓸 수 있는 인증 표면은 core.dependencies / core.security 뿐이며,
# 개인키를 다루는 발급 코드(auth.*)를 스포크가 import해서는 안 된다.
name = apps.auth is only imported by auth_main
type = forbidden
source_modules =
    fridge
    titanic
    secom
    doro
    friday_13th
    imitation_game
    inception
    lion_king
    silicon_valley
    users
    star_craft
    weather
forbidden_modules =
    auth

[importlinter:contract:star-topology-no-spoke-to-spoke]
# Harness Rule: 스포크 → 스포크 직접 참조 금지
# 스포크 간 공유가 필요하면 반드시 star_craft 또는 core를 경유한다.
name = Spoke modules must not import each other directly
type = independence
modules =
    fridge
    titanic
    secom
    doro
    friday_13th
    imitation_game
    inception
    lion_king
    silicon_valley
    users
    weather

[importlinter:contract:clean-arch-inbound-no-outbound]
# Harness Rule: 클린 아키텍처 — inbound adapter는 outbound를 직접 import 불가
name = Inbound adapters must not import outbound adapters
type = forbidden
source_modules =
    fridge.adapter.inbound
    titanic.adapter.inbound
    weather.adapter.inbound
forbidden_modules =
    fridge.adapter.outbound
    titanic.adapter.outbound
    weather.adapter.outbound

[importlinter:contract:clean-arch-usecase-no-adapter]
# Harness Rule: use_cases는 adapter 구현체를 직접 import 불가 (포트만 의존)
name = Use cases must not import adapter implementations
type = forbidden
source_modules =
    fridge.app.use_cases
    titanic.app.use_cases
    weather.app.use_cases
forbidden_modules =
    fridge.adapter
    titanic.adapter
    weather.adapter

[importlinter:contract:hub-can-import-spokes]
# star_craft(Hub)는 모든 스포크를 import할 수 있다 — 허용 규칙 명시
name = Hub (star_craft) is allowed to import any spoke
type = layers
layers =
    star_craft
    fridge | titanic | secom | doro | friday_13th | imitation_game | inception | lion_king | silicon_valley | users | weather
